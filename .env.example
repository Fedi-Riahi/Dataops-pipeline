# Copy to .env (git-ignored) and fill in. Never commit .env.
NASS_API_KEY=            # free key: https://quickstats.nass.usda.gov/api
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-please
S3_BUCKET=iowa-yield
S3_ENDPOINT_URL=http://minio:9000   # remove / change for real AWS S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-please
AWS_REGION=us-east-1
WAREHOUSE_PATH=/data/warehouse.duckdb
ALERT_WEBHOOK_URL=       # Slack/Discord webhook, optional
START_YEAR=2015
